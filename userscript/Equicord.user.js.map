anced server search with quick switcher integration"},"showBadgesInChat":{"description":"Show user badges in chat messages","settings":{"DiscordNitroPosition":"The position of the Discord Nitro badge","DiscordProfilePosition":"The position of the Discord profile badges","EquicordContributorPosition":"The position of the Equicord Contributor badge","EquicordDonorPosition":"The position of the Equicord Donor badges","VencordContributorPosition":"The position of the Vencord Contributor badge","VencordDonorPosition":"The position of the Vencord Donor badges","badgeSettings":"Setup badge layout and visibility","showDiscordNitro":"Enable to show Discord Nitro badges in chat","showDiscordProfile":"Enable to show Discord profile badges in chat","showEquicordContributor":"Enable to show Equicord Contributor badges in chat","showEquicordDonor":"Enable to show Equicord Donor badges in chat","showVencordContributor":"Enable to show Vencord contributor badges in chat","showVencordDonor":"Enable to show Vencord donor badges in chat"}},"showMessageEmbeds":{"description":"Show message embeds with options to add or remove embeds from messages"},"showResourceChannels":{"description":"Show resource channels that are normally hidden"},"showSongName":{"description":"Show currently playing song name in status"},"sidebarChat":{"description":"Sidebar chat interface for viewing multiple channels","settings":{"patchCommunity":"Patch things like the Channel Browser or Members tab that community servers have","persistSidebar":"Keep the sidebar chat open across Discord restarts"}},"signature":{"description":"Add signatures to messages","settings":{"contextMenu":"Add option to toggle the functionality in the chat input context menu","isEnabled":"Toggle functionality","name":"The signature that will be added to the end of your messages","showIcon":"Show an icon for toggling the plugin in the chat bar","textHeader":"What header to preface text with"}},"snowfall":{"description":"Adds a christmas-y 
eGuidelines":" Możesz jednak zobaczyć jego wytyczne:","settings":{"channelStyle":{"classic":"Klasyczny","description":"Styl używany do wyświetlania ukrytych kanałów.","muted":"Wyciszono","mutedAndShowUnreads":"Wyciszone i pokaż nieprzeczytane","showUnreads":"Pokaż nieprzeczytane"},"defaultAllowedUsersAndRolesDropdownState":{"description":"Określa, czy lista dozwolonych użytkowników i ról w ukrytych kanałach powinna być domyślnie otwarta"},"showMode":{"description":"Tryb używany do wyświetlania ukrytych kanałów.","eyeIconRight":"Ikona oka po prawej stronie","lockIcon":"Ikona kłódki zastępująca ikonę kanału","lockIconRight":"Ikona kłódki po prawej stronie"}},"slowmode":"Tryb zwolniony: {duration}","sortOrders":{"creationDate":"Data utworzenia","latestActivity":"Najnowsza aktywność"},"threadSlowmode":"Domyślny tryb spowolnienia wątku: {duration}","videoQuality":{"720p":"720p","automatic":"Automatyczny"},"videoQualityMode":"Tryb jakości wideo: {mode}","viewAllowedUsersAndRoles":"Wyświetl dozwolonych użytkowników i role"},"showHiddenThings":{"description":"Wyświetla różne ukryte i dostępne tylko dla moderatorów rzeczy, niezależnie od uprawnień.","settings":{"showInvitesPaused":"Pokaż etykietkę wstrzymanych zaproszeń na liście serwerów.","showModView":"Pokaż element menu kontekstowego widoku modów członkowskich na wszystkich serwerach.","showTimeouts":"Pokaż ikony limitu czasu członka na czacie."}},"showMeYourName":{"addNickname":"Dodaj pseudonim SMYN","cancel":"Anuluj","changeNickname":"Zmień pseudonim SMYN","modalDescription":"Ustaw niestandardowy pseudonim SMYN dla tego użytkownika. Skorzystaj z tego, określając {custom} w ustawieniach szablonu SMYN.","nicknameLabel":"Pseudonim SMYN","resetNickname":"Zresetuj pseudonim SMYN","save":"Zapisz","settings":{"animateGradients":"W przypadku nazw innych niż podstawowe, jeśli rola ma gradient, animuj ją. Jest to wyłączone przez opcję „Ignoruj gradienty” i ograniczony ruch.","customNameColor":"Kolor niestandardowej nazwy przypisanej użytkownikowi, jeśli nie jest ona wyświetlana jako pierwsza. Pozostaw puste jako domyślne. Akceptuje wejście hex(a), rgb(a) lub hsl(a). Użyj opcji „Rola”, aby śledzić kolor najważniejszej roli użytkownika. Użyj „Rola+-#”, aby dostosować jasność o ten procent (np. „Rola+15”)","discriminators":"Dołącz wyróżniki do nazw użytkowników dla botów. Dyskryminatory zostały wycofane w przypadku użytkowników, ale nadal są używane w przypadku botów. Domyślnie nazwa użytkownika bota jest równoważna globalnej nazwie użytkownika, dlatego wiele botów może mieć tę samą nazwę użytkownika. Dołączenie dyskryminatorów sprawia, że znów stają się one unikalne.","displayNameColor":"Kolor nazwy wyświetlanej, jeśli nie jest ona wyświetlana jako pierwsza. Pozostaw puste jako domyślne. Akceptuje wejście hex(a), rgb(a) lub hsl(a). Użyj opcji „Rola”, aby śledzić kolor najważniejszej roli użytkownika. Użyj „Rola+-#”, aby dostosować jasność o ten procent (np. „Rola+15”)","friendNameColor":"Kolor pseudonimu znajomego, jeśli nie jest on wyświetlany jako pierwszy. Pozostaw puste jako domyślne. Akceptuje wejście hex(a), rgb(a) lub hsl(a). Użyj opcji „Rola”, aby śledzić kolor najważniejszej roli użytkownika. Użyj „Rola+-#”, aby dostosować jasność o ten procent (np. „Rola+15”)","hideDefaultAtSign":"Ukryj domyślny symbol „@” przed nazwą we wzmiankach i odpowiedziach. Stosowane tylko wtedy, gdy którakolwiek funkcja jest włączona.","ignoreFonts":"W przypadku nazw innych niż podstawowe użyj domyślnych czcionek Discord, niezależnie od niestandardowej czcionki nitro użytkownika.","ignoreGradients":"W przypadku nazw innych niż podstawowe, jeśli rola ma gradient, zignoruj go na rzecz poniższego zestawu kolorów.","includedNames":"Kolejność wyświetlania nazw użytkowników, nazw wyświetlanych, pseudonimów, imion znajomych i nazw niestandardowych. Użyj następujących symboli zastępczych: {user}, {display}, {nick}, {friend}, {custom}. Możesz podać wiele opcji nazw, które będą używane jako nazwy zastępcze, jeśli jedna z nich jest niedostępna, oddzielając je przecinkami: {custom, friend, nick}. Na każdą nazwę możesz mieć maksymalnie trzy prefiksy i trzy sufiksy.","memberList":"Wyświetl na liście członków pierwszą dostępną nazwę wymienioną w niestandardowym formacie nazwy.","mentions":"Wyświetlaj we wzmiankach niestandardowy format nazwy.","messages":"Wyświetlaj w wiadomościach niestandardowy format nazwy.","nameSeparator":"Separator używany między nazwami. Wartość domyślna to pojedyncza spacja.","nicknameColor":"Kolor pseudonimu, jeśli nie jest on wyświetlany jako pierwszy. Pozostaw puste jako domyślne. Akceptuje wejście hex(a), rgb(a) lub hsl(a). Użyj opcji „Rola”, aby śledzić kolor najważniejszej roli użytkownika. Użyj „Rola+-#”, aby dostosować jasność o ten procent (np. „Rola+15”)","profilePopout":"Wyświetlaj pierwszą dostępną nazwę wymienioną w niestandardowym formacie nazwy w wyskakujących okienkach profilu.","reactions":"Wyświetlaj pierwszą dostępną nazwę wymienioną w niestandardowym formacie nazwy w podpowiedziach reakcji, a pełne imię i nazwisko w wyskakujących okienkach reakcji.","removeDuplicates":"Jeżeli którekolwiek z nazw są równoważne, usuń je, pozostawiając jedynie nazwy unikalne.","replies":"Wyświetlaj w odpowiedziach niestandardowy format nazwy.","truncateAllNamesWithStreamerMode":"Obetnij wszystkie nazwy, nie tylko nazwy użytkowników, w trybie streamera.","usernameColor":"Kolor nazwy użytkownika, jeśli nie jest ona wyświetlana jako pierwsza. Pozostaw puste jako domyślne. Akceptuje wejście hex(a), rgb(a) lub hsl(a). Użyj opcji „Rola”, aby śledzić kolor najważniejszej roli użytkownika. Użyj „Rola+-#”, aby dostosować jasność o ten procent (np. „Rola+15”)","voiceChannels":"Wyświetlaj pierwszą dostępną nazwę wymienioną w niestandardowym formacie nazwy w kanałach głosowych."}},"showTimeoutDuration":{"description":"Pokazuje, jak długo będzie trwał limit czasu użytkownika, w etykiecie ikony limitu czasu lub obok niej","displayStyleDescription":"Jak wyświetlić czas oc
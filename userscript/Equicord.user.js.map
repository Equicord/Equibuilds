ם מורשים"},"showHiddenThings":{"description":"מציג דברים שונים מוסתרים ומודרים בלבד ללא קשר להרשאות.","settings":{"showInvitesPaused":"הצג את הסבר הכלים של ההזמנות שהושהו ברשימת השרתים.","showModView":"הצג את פריט תפריט ההקשר של תצוגת מוד חבר בכל השרתים.","showTimeouts":"הצג סמלי פסק זמן של חבר בצ'אט."}},"showMeYourName":{"addNickname":"הוסף כינוי SMYN","cancel":"לְבַטֵל","changeNickname":"שנה כינוי SMYN","modalDescription":"הגדר כינוי SMYN מותאם אישית עבור משתמש זה. השתמש בו על ידי ציון {custom} בהגדרות תבנית SMYN.","nicknameLabel":"כינוי SMYN","resetNickname":"אפס את כינוי SMYN","save":"לְהַצִיל","settings":{"animateGradients":"עבור השמות הלא ראשוניים, אם לתפקיד יש שיפוע, הנפש אותו. זה מושבת על ידי \"התעלם מהדרגות\" ותנועה מופחתת.","customNameColor":"הצבע שישמש עבור השם המותאם אישית שהקצית למשתמש אם הוא לא הראשון שמוצג. השאר ריק לברירת המחדל. מקבל קלט hex(a), rgb(a) או hsl(a). השתמש ב\"תפקיד\" כדי לעקוב אחר צבע התפקיד העליון של המשתמש. השתמש ב-\"Role+-#\" כדי להתאים את הבהירות באחוז זה (לדוגמה: \"Role+15\")","discriminators":"הוסף מפלים לשמות משתמש עבור בוטים. מפלים הוצאו משימוש עבור משתמשים, אך עדיין משמשים עבור בוטים. כברירת מחדל, שם משתמש של בוט שווה ערך לשם הגלובלי של משתמש, ולכן לבוטים מרובים יכולים להיות אותו שם משתמש. הוספת מפלים הופכת אותם שוב לייחודיים.","displayNameColor":"הצבע שיש להשתמש בו עבור שם התצוגה אם הוא לא הראשון המוצג. השאר ריק לברירת המחדל. מקבל קלט hex(a), rgb(a) או hsl(a). השתמש ב\"תפקיד\" כדי לעקוב אחר צבע התפקיד העליון של המשתמש. השתמש ב-\"Role+-#\" כדי להתאים את הבהירות באחוז זה (לדוגמה: \"Role+15\")","friendNameColor":"הצבע לשימוש עבור הכינוי של חבר אם זה לא הראשון המוצג. השאר ריק לברירת המחדל. מקבל קלט hex(a), rgb(a) או hsl(a). השתמש ב\"תפקיד\" כדי לעקוב אחר צבע התפקיד העליון של המשתמש. השתמש ב-\"Role+-#\" כדי להתאים את הבהירות באחוז זה (לדוגמה: \"Role+15\")","hideDefaultAtSign":"הסתר את סמל ברירת המחדל \"@\" לפני השם באזכורים ובתשובות. מיושם רק אם אחת התכונות מופעלת.","ignoreFonts":"עבור השמות הלא ראשיים, השתמש בגופני ברירת המחדל של Discord ללא קשר לגופן הניטרו המותאם אישית של המשתמש.","ignoreGradients":"עבור השמות הלא ראשוניים, אם לתפקיד יש שיפוע, התעלם ממנו לטובת ערכת הצבעים למטה.","includedNames":"הסדר להצגת שמות משתמש, שמות תצוגה, כינויים, שמות חברים ושמות מותאמים אישית. השתמש במצייני המיקום הבאים: {user}, {display}, {nick}, {friend}, {custom}. אתה יכול לספק אפשרויות שמות מרובות לשימוש כחלופות אם אחת אינה זמינה על ידי הפרדתן באמצעות פסיקים ככאלה: {custom, friend, nick}. אתה יכול לקבל עד שלוש קידומות ושלוש סיומות לכל שם.","memberList":"הצג את השם הזמין הראשון הרשום בפורמט השם המותאם אישית שלך ברשימת החברים.","mentions":"הצג פורמט שם מותאם אישית באזכורים.","messages":"הצג פורמט שם מותאם אישית בהודעות.","nameSeparator":"המפריד לשימוש בין שמות. ברירת המחדל היא רווח בודד.","nicknameColor":"הצבע שיש להשתמש בו עבור הכינוי אם הוא לא הראשון שמוצג. השאר ריק לברירת המחדל. מקבל קלט hex(a), rgb(a) או hsl(a). השתמש ב\"תפקיד\" כדי לעקוב אחר צבע התפקיד העליון של המשתמש. השתמש ב-\"Role+-#\" כדי להתאים את הבהירות באחוז זה (לדוגמה: \"Role+15\")","profilePopout":"הצג את השם הזמין הראשון הרשום בפורמט השם המותאם אישית שלך בחלונות קופצים של הפרופיל.","reactions":"הצג את השם הזמין הראשון הרשום בפורמט השם המותאם אישית שלך בטיפים של התגובה, ואת השם המלא בחלונות קופצים של תגובה.","removeDuplicates":"אם אחד מהשמות שווה ערך, הסר אותם, והשאר רק את השמות הייחודיים.","replies":"הצג פורמט שם מותאם אישית בתשובות.","truncateAllNamesWithStreamerMode":"קצץ את כל השמות, לא רק שמות משתמש, תוך כדי מצב סטרימר.","usernameColor":"הצבע לשימוש עבור שם המשתמש אם הוא לא הראשון המוצג. השאר ריק לברירת המחדל. מקבל קלט hex(a), rgb(a) או hsl(a). השתמש ב\"תפקיד\" כדי לעקוב אחר צבע התפקיד העליון של המשתמש. השתמש ב-\"Role+-#\" כדי להתאים את הבהירות באחוז זה (לדוגמה: \"Role+15\")","voiceChannels":"הצג את השם הזמין הראשון הרשום בפורמט השם המותאם אישית שלך בערוצים קוליים."}},"showTimeoutDuration":{"description":"מראה כמה זמן יימשך הזמן הקצוב של משתמש, או בהסבר הכלי של סמל הזמן הקצוב או לצדו","displayStyleDescription":"כיצד להציג את משך הזמן הקצוב",
ой прати, сложи реакция или ползва moyai емотикон във вашия канал.","settings":{"ignoreBlocked":"Игнорирайте съобщения от блокирани потребители","ignoreBots":"Игнориране на съобщения от ботове","quality":"Качеството на звука moyai","qualityOptions":{"hd":"HD","normal":"нормално"},"triggerWhenUnfocused":"Звук за задействане дори когато прозорецът не е фокусиран","volume":"Сила на звука moyai"}},"musicControls":{"description":"Показване на контролите за музикален плейър за Spotify, Tidal и YouTube Music","settings":{"FallbackProvider":"Използвайте резервен доставчик, когато основният не успее","LyricDelay":"Отместване на забавянето на текста","LyricsConversion":"Автоматичен превод на романизирани текстове","LyricsPosition":"Позиция на текста спрямо играча","LyricsProvider":"Източник на текстове","ShowFailedToasts":"Показване на тостове за грешка, когато текстовете не успеят да се заредят","TranslateTo":"Превод на текстове на","YoutubeMusicApiUrl":"Персонализирана музика в YouTube API URL","hoverControls":"Показване на контроли само при задържане","previousButtonRestartsTrack":"Рестартирайте песента при натискане на предишния бутон","showSpotifyControls":"Показване на контролите на Spotify","showSpotifyLyrics":"Показване на текстове на Spotify","showTidalControls":"Показване на контролите на Tidal","showTidalLyrics":"Показване на текстове на Tidal","showYoutubeMusicControls":"Показване на контролите на YouTube Music","useSpotifyUris":"Отворете Spotify URI вместо URL адреси"}},"neverPausePreviews":{"description":"Никога не поставяйте на пауза визуализациите на видео, когато превключвате канали или разфокусирате","warning":"Това може да увеличи използването на ресурси и потреблението на данни"},"newPluginsManager":{"description":"Управлявайте и откривайте нови плъгини с мениджъра на плъгини"},"noAppsAllowed":{"description":"Блокира показването на приложения/категории в стартовия панел на приложения"},"noBulletPoints":{"description":"Премахнете точките от съобщенията, кат
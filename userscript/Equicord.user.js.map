le":"รูปแบบความสั่นสะเทือนของหน้าต่าง (ต้องรีสตาร์ท)"},"notification":{"logButton":"ดูบันทึกการแจ้งเตือน","settingsButton":"ตั้งค่าการแจ้งเตือน"},"plugins":{"contributorModal":{"contributorInfo":{"noPlugins":"บุคคลนี้ยังไม่ได้สร้างปลั๊กอินใดๆ พวกเขา <0>มีส่วนร่วม</0> ให้กับ Equicord ในรูปแบบอื่น!","plugins_one":"บุคคลนี้ได้<0>มีส่วนร่วม</0>กับปลั๊กอิน {count}!","plugins_other":"บุคคลนี้ได้<0>มีส่วนร่วม</0>กับปลั๊กอิน {count}!"}},"noDescription":"ไม่มีคำอธิบาย","pluginRequiredBy":"ปลั๊กอินนี้ต้องการโดย: {pluginNames}","requiredToFunction":"ต้องใช้ปลั๊กอินนี้เพื่อให้ Equicord ทำงาน"},"restartRequired":{"body":"จำเป็นต้องรีสตาร์ทเพื่อใช้การเปลี่ยนแปลงนี้","cancel":"ภายหลัง!","confirm":"เริ่มต้นใหม่ตอนนี้","plugins":"ปลั๊กอินต่อไปนี้จำเป็นต้องรีสตาร์ท:","title":"จำเป็นต้องรีสตาร์ท"},"title":"การตั้งค่า","transparent":{"description":"ทำให้หน้าต่าง Discord โปร่งใส จำเป็นต้องมีธีมที่สนับสนุนความโปร่งใส ไม่เช่นนั้นจะไม่ทำอะไรเลย","note":"ซึ่งจะทำให้หน้าต่างไม่สามารถปรับขนาดได้","noteWindows":"ซึ่งจะทำให้หน้าต่างไม่สามารถปรับขนาดได้ และป้องกันไม่ให้คุณสแนปหน้าต่างไปจนถึงขอบหน้าจอ","title":"เปิดใช้งานความโปร่งใสของหน้าต่าง"},"useQuickCss":{"description":"โหลด CSS ที่กำหนดเองจากโปรแกรมแก้ไข QuickCSS ซึ่งช่วยให้คุณปรับแต่งรูปลักษณ์ของ Discord ตามสไตล์ของคุณเองได้","title":"เปิดใช้งาน CSS แบบกำหนดเอง"},"winCtrlQ":{"description":"เพิ่ม Ctrl+Q เป็นแป้นพิมพ์ลัดเพื่อปิด Discord นี่เป็นทางเลือกแทน Alt+F4 เพื่อการปิดแอปพลิเคชันอย่างรวดเร็ว","title":"ลงทะเบียน Ctrl+Q เป็นทางลัดเพื่อปิด Discord"},"winNativeTitleBar":{"description":"แทนที่แถบหัวเรื่องแบบกำหนดเองของ Discord ด้วยแถบหัวเรื่อง Windows มาตรฐาน ซึ่งอาจปรับปรุงความเข้ากันได้กับเครื่องมือการจัดการหน้าต่างบางอย่าง","title":"ใช้แถบชื่อเรื่องดั้งเดิมของ Windows แทนแถบชื่อเรื่องที่กำหนดเองของ Discord"}},"settingsSync":{"failedToImport":"ไม่สามารถนำเข้าการตั้งค่า: {e}","imported":"นำเข้าการตั้งค่าเรียบร้อยแล้ว รีสตาร์ทเพื่อใช้การเปลี่ยนแปลง!"},"shikiCodeblocks":{"description":"นำ codeblocks สไตล์ vscode มาสู่ Discord ซึ่งขับเคลื่อนโดย Shiki","settings":{"bgOpacity":"ความทึบของพื้นหลัง","customTheme":"ลิงก์ไปยังธีม vscode ที่กำหนดเอง","theme":"ธีมเริ่มต้น","tryHljs":"ใช้ปากกาเน้นข้อความและธีมเริ่มต้น Discord ที่มีน้ำหนักเบากว่า","tryHljsOptions":{"always":"ตลอด","never":"ไม่ต้อง","preferHljs":"ชอบ Highlight.js แทน Shiki","preferShiki":"ชอบ Shiki แทน Highlight.js"},"useDevIcon":"วิธีแสดงไอคอนภาษาบน codeblocks","useDevIconOptions":{"colored":"สี","colorless":"ไม่มีสี","disabled":"ระงับแล้ว"}}},"showAllMessageButtons":{"description":"แสดงปุ่มข้อความทั้งหมดเสมอ ไม่ว่าคุณจะกดปุ่ม Shift ค้างไว้หรือไม่ก็ตาม","settings":{"noShiftDelete":"ลบข้อกำหนดเพื่อระงับกะสำหรับการลบข้อความ","noShiftPin":"ลบข้อกำหนดในการกด Shift ค้างไว้เพื่อปักหมุดข้อความ"}},"showConnections":{"description":"แสดงบัญชีที่เชื่อมต่อกันในหน้าต่างป๊อปอัปของผู้ใช้","settings":{"compact":"กะทัดรัด","cozy":"อบอุ่นสบาย","iconSize":"ขนาดไอคอน (พิกเซล)","iconSpacing":"ขอบไอคอน","roomy":"กว้างขวาง"}},"showHiddenChannels":{"allowedUsersAndRoles":"ผู้ใช้และบทบาทที่ได้รับอนุญาต:","archiveDuration":"ระยะเวลาการไม่ใช้งานเริ่มต้นก่อนการเก็บถาวร {type}: {duration}","availableTags":"แท็กที่มีอยู่:","bitrate":"บิตเรต: {bitrate} บิต","cannotSeeMessages":"คุณไม่สามารถดู {type} ของช่องนี้ได้","channelTypes":{"announcement":"ประกาศ","forum":"ฟอรั่ม","message":"ข้อความ","messages":"ข้อความ","post":"โพสต์","posts":"โพสต์","stage":"เวที","text":"ข้อความ","thread":"ด้าย","threads":"หัวข้อ","voice":"เสียง"},"defaultLayout":"เค้าโครงเริ่มต้น: {layout}","defaultReactionEmoji":"อีโมจิปฏิกิริยาเริ่มต้น:","defaultSortOrder":"ลำดับการจัดเรียงเริ่มต้น: {order}","description":"แสดงช่องที่คุณไม่มีสิทธิ์เข้าถึงเพื่อดู","forumLayouts":{"gridView":"มุมมองแกลเลอรี่","listView":"มุมมองรายการ","notSet":"ไม่ได้ตั้งค่า"},"hiddenChannel":"นี่คือช่อง {type} ที่ซ่อนอยู่","hiddenChannelTooltip":"ช่องที่ซ่อนอยู่","hideAllowedUsersAndRoles":"ซ่อนผู้ใช้และบทบาทที่ได้รับอนุญาต","lastMessageCreated":"{type} ที่สร้างล่าสุด:","lastMessagePin":"ปักหมุดข้อความล่าสุด:","lockedChannel":"นี่คือ